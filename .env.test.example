# Base de datos EXCLUSIVA para tests: se borran y recrean datos en cada corrida.
# Preparar con:  sed 's/nutribox_db/nutribox_test/g' database/schema.sql | mysql -u root -p
#                sed 's/nutribox_db/nutribox_test/g' database/seed.sql   | mysql -u root -p
RUN_INTEGRATION=true
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nutribox_test
MONGODB_URI=mongodb://127.0.0.1:27017/nutribox_test
JWT_SECRET=
